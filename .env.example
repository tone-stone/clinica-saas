# Dominio raíz de la app (sin protocolo), usado para detectar subdominios de tenant
NEXT_PUBLIC_ROOT_DOMAIN=tuapp.com
# En desarrollo local usar: NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID_ANNUAL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend (correo transaccional: confirmaciones de cita, invitaciones)
RESEND_API_KEY=
RESEND_FROM_EMAIL=citas@tuapp.com
